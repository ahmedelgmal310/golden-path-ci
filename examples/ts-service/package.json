{
  "name": "ts-service",
  "version": "1.0.0",
  "private": true,
  "description": "Sample TypeScript consumer of the golden-path workflows",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.11"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "node --test --experimental-test-coverage --test-coverage-lines=80 \"src/**/*.test.ts\"",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "6.0.3"
  }
}
